{
    "type": "petra-xiao-s3",
    "target": "esp32s3",
    "builds": [
        {
            "name": "petra-xiao-s3",
            "sdkconfig_append": [
                "CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y",
